# Cloudflare R2 photo gallery (optional — /gallery shows a notice without these)
VITE_R2_PUBLIC_URL=https://your-bucket.r2.dev
VITE_R2_LIST_ENDPOINT=https://your-worker.workers.dev/list

# Spotify "now playing" on /music (optional — the widget hides itself without it)
# The worker holds the Spotify client ID, secret and refresh token as Worker
# secrets. Never put them in a VITE_* variable: Vite inlines those into the
# client bundle, where anyone can read them.
VITE_NOW_PLAYING_ENDPOINT=https://your-worker.workers.dev/now-playing
