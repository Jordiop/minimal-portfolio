# Cloudflare R2 photo gallery (optional — /gallery shows a notice without these)
VITE_R2_PUBLIC_URL=https://your-bucket.r2.dev
VITE_R2_LIST_ENDPOINT=https://your-worker.workers.dev/list

# Spotify "now playing" on /music (optional — the widget hides itself without these)
# NOTE: Vite inlines VITE_* variables into the client bundle, so these are public.
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_CLIENT_SECRET=
VITE_SPOTIFY_REFRESH_TOKEN=
